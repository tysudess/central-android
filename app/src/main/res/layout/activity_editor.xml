<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_future"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="9dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp">

            <Button
                android:id="@+id/buttonEditorBack"
                style="@style/AppNeutralButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="←"
                android:textSize="19sp" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Logo da Central Inteligente de Mídia"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CENTRAL • EDIÇÃO"
                    android:textColor="@color/accent"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Editor de Vídeo"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Corte, organize, una e exporte"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textEditorClipCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_status"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="0 clipes"
                android:textColor="@color/success"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:background="@drawable/bg_preview"
                android:padding="5dp">

                <TextureView
                    android:id="@+id/editorPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Prévia da sequência de vídeos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="9dp"
                    android:background="@drawable/bg_badge"
                    android:text="PRÉVIA"
                    android:textColor="@color/accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <TextView
                    android:id="@+id/textEditorSequenceCurrent"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00.000"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/editorBack5s"
                    style="@style/AppNeutralButton"
                    android:layout_width="46dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="−5s"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/buttonEditorPreview"
                    style="@style/AppPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="▶  Reproduzir sequência"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/editorForward5s"
                    style="@style/AppNeutralButton"
                    android:layout_width="46dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="+5s"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textEditorSequenceTotal"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00.000"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_timeline_panel"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TIMELINE  •  toque para navegar  •  segure e arraste para reordenar"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/editorZoomOut"
                    style="@style/AppNeutralButton"
                    android:layout_width="40dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/textEditorTimelineZoom"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ZOOM 3/7"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/editorZoomIn"
                    style="@style/AppNeutralButton"
                    android:layout_width="40dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textSize="17sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/editorTimelineScroll"
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <br.com.extratorvideos.TimelineEditorView
                    android:id="@+id/editorTimeline"
                    android:layout_width="wrap_content"
                    android:layout_height="148dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AJUSTE FINO DO CURSOR"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="posicione • corte"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <Button android:id="@+id/editorBack1s" style="@style/AppTimeButton" android:layout_width="60dp" android:layout_height="42dp" android:text="−1s" />
                    <Button android:id="@+id/editorBack100ms" style="@style/AppTimeButton" android:layout_width="68dp" android:layout_height="42dp" android:layout_marginStart="4dp" android:text="−100ms" />
                    <Button android:id="@+id/editorBack10ms" style="@style/AppTimeButton" android:layout_width="60dp" android:layout_height="42dp" android:layout_marginStart="4dp" android:text="−10ms" />
                    <Button android:id="@+id/editorForward10ms" style="@style/AppTimeButton" android:layout_width="60dp" android:layout_height="42dp" android:layout_marginStart="4dp" android:text="+10ms" />
                    <Button android:id="@+id/editorForward100ms" style="@style/AppTimeButton" android:layout_width="68dp" android:layout_height="42dp" android:layout_marginStart="4dp" android:text="+100ms" />
                    <Button android:id="@+id/editorForward1s" style="@style/AppTimeButton" android:layout_width="60dp" android:layout_height="42dp" android:layout_marginStart="4dp" android:text="+1s" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <Button android:id="@+id/buttonEditorAdd" style="@style/AppPrimaryButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.15" android:text="＋  Adicionar" />
                <Button android:id="@+id/buttonEditorCut" style="@style/AppSecondaryButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="✂  Cortar" />
                <Button android:id="@+id/buttonEditorRemove" style="@style/AppDangerButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="Excluir trecho" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <Button android:id="@+id/buttonEditorDuplicate" style="@style/AppNeutralButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="⧉  Duplicar" />
                <Button android:id="@+id/buttonEditorUp" style="@style/AppNeutralButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="←  Esquerda" />
                <Button android:id="@+id/buttonEditorDown" style="@style/AppNeutralButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="Direita  →" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:text="CLIP INSPECTOR" android:textColor="@color/warning" android:textSize="10sp" android:textStyle="bold" />

            <TextView android:id="@+id/textEditorSelected" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:ellipsize="middle" android:maxLines="1" android:text="Selecione um clipe na timeline" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />

            <TextView android:id="@+id/textEditorInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Toque em um bloco para ajustar o início e o fim." android:textColor="@color/text_secondary" android:textSize="11sp" />

            <br.com.extratorvideos.RangeSelectionView android:id="@+id/editorRangeSelector" android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="9dp" android:visibility="gone" />

            <TextView android:id="@+id/textEditorPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="--:--" android:textColor="@color/purple" android:textSize="12sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INÍCIO" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" />
                    <EditText android:id="@+id/editEditorStart" style="@style/AppTimeInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:hint="00:00:00.000" android:inputType="text" android:singleLine="true" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIM" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" />
                    <EditText android:id="@+id/editEditorEnd" style="@style/AppTimeInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:hint="00:00:00.000" android:inputType="text" android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/buttonEditorApplyTimes" style="@style/AppSecondaryButton" android:layout_width="match_parent" android:layout_height="47dp" android:layout_marginTop="7dp" android:text="Aplicar corte ao clipe selecionado" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <Button android:id="@+id/editorMarkStart" style="@style/AppSecondaryButton" android:layout_width="0dp" android:layout_height="47dp" android:layout_weight="1" android:text="Marcar início aqui" android:textSize="11sp" />
                <Button android:id="@+id/editorMarkEnd" style="@style/AppSecondaryButton" android:layout_width="0dp" android:layout_height="47dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Marcar fim aqui" android:textSize="11sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="13dp" android:background="#D6E4F1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Dica: posicione a linha na timeline e toque em ✂ Cortar. Cada toque cria um novo corte visível. Para apagar uma parte, faça um corte no início e outro no fim, selecione o trecho entre eles e toque em Excluir trecho." android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:text="RENDER / EXPORT" android:textColor="@color/accent" android:textSize="10sp" android:textStyle="bold" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Exportar sequência" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />

            <EditText android:id="@+id/editEditorOutputName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="9dp" android:background="@drawable/bg_input" android:hint="Nome do arquivo final" android:inputType="text" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Resolução de saída" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spinnerEditorResolution" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:paddingStart="12dp" android:paddingEnd="12dp" android:popupBackground="@color/surface" android:spinnerMode="dropdown" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Original preserva a resolução atual. 360p, 480p, 720p e 1080p redimensionam mantendo a proporção." android:textColor="@color/text_muted" android:textSize="10sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Modo de compressão" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spinnerEditorCompression" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:paddingStart="12dp" android:paddingEnd="12dp" android:popupBackground="@color/surface" android:spinnerMode="dropdown" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="HEVC gera arquivos menores mantendo qualidade visual semelhante. Se o aparelho não tiver encoder HEVC, o app usa H.264 automaticamente." android:textColor="@color/text_muted" android:textSize="10sp" />

            <CheckBox android:id="@+id/checkEditorTargetSize" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:buttonTint="@color/accent" android:gravity="center_vertical" android:text="Definir tamanho aproximado do arquivo" android:textColor="@color/text_primary" android:textSize="12sp" />

            <LinearLayout android:id="@+id/panelEditorTargetSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_status" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tamanho alvo" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/textEditorTargetSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="≈ 30 MB" android:textColor="@color/accent" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekEditorTargetSize" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:max="1000" android:progress="500" android:progressBackgroundTint="@color/border" android:progressTint="@color/accent" android:thumbTint="@color/purple" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/textEditorTargetMin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1 MB" android:textColor="@color/text_muted" android:textSize="10sp" />
                    <TextView android:id="@+id/textEditorTargetMax" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="100 MB" android:textColor="@color/text_muted" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="O valor é um alvo aproximado. O encoder do aparelho pode gerar um arquivo um pouco maior ou menor." android:textColor="@color/text_muted" android:textSize="10sp" />
            </LinearLayout>

            <TextView android:id="@+id/textEditorExportEstimate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_playback_tip" android:padding="10dp" android:text="Adicione um vídeo para calcular resolução, bitrate e tamanho estimado." android:textColor="@color/text_secondary" android:textSize="11sp" />

            <Button android:id="@+id/buttonEditorJoin" style="@style/AppPrimaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:text="Exportar vídeo final" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_status" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Renderização" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/textEditorJoinProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progressEditorJoin" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressBackgroundTint="@color/border" android:progressTint="@color/accent" />
                <TextView android:id="@+id/textEditorStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:text="Adicione um vídeo à timeline para editar e exportar." android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
